# Copy to .env and fill in what you have. Every value below has a safe
# fallback (see backend/app/core/config.py) so the app runs with zero keys
# configured — external calls fall back to mock/seed data instead of failing.

# --- Backend ---
DATABASE_URL=postgresql://fishpilot:fishpilot@db:5432/fishpilot
# For local dev without Docker/Postgres: DATABASE_URL=sqlite:///./fishpilot_dev.db

NWS_USER_AGENT=fishmate (you@example.com)   # required by NWS API etiquette, no key needed
NOMINATIM_USER_AGENT=fishmate (you@example.com) # required by Nominatim's usage policy, no key needed
GOOGLE_PLACES_API_KEY=                           # optional — nearby bait shops fall back to seed data without it

LLM_PROVIDER=mock                                # mock | anthropic
LLM_API_KEY=                                     # backend .env only; never in the frontend
LLM_MODEL=                                       # blank = provider default (anthropic: claude-haiku-4-5)

# Demo/debug hook for the mock provider (see docs/adr/0007-ai-advisor-grounding.md).
# Lets you reproduce each advisor failure path on demand instead of waiting
# for a real model to misbehave:
#   none | unavailable | invalid_json | hallucinated_source | hallucinated_species
#   | invented_number (fish-guide Q&A only)
LLM_MOCK_FAILURE_MODE=none

# --- Accounts and community pins (docs/adr/0016-accounts-and-community-pins.md) ---
FRONTEND_ORIGIN=http://localhost:3000            # CORS, the CSRF origin check, OAuth return
API_PUBLIC_URL=http://localhost:8000             # Google's redirect URI is built on this
COOKIE_SECURE=false                              # true whenever the site is served over HTTPS
MEDIA_ROOT=./media                               # uploaded photos (gitignored)
# Optional "Sign in with Google": create an OAuth client (Web application) in
# Google Cloud Console with redirect URI  http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

USE_SEED_DATA_ONLY=true
# true = show only commercially usable GBIF records (CC0, CC BY); see docs/commercialization.md
GBIF_EXCLUDE_NONCOMMERCIAL=false

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
