# Copy to .env and fill in what you have. Every value below has a safe
# fallback (see backend/app/core/config.py) so the app runs with zero keys
# configured — external calls fall back to mock/seed data instead of failing.

# --- Backend ---
DATABASE_URL=postgresql://fishpilot:fishpilot@db:5432/fishpilot
# For local dev without Docker/Postgres: DATABASE_URL=sqlite:///./fishpilot_dev.db

NWS_USER_AGENT=fishpilot-ai (you@example.com)   # required by NWS API etiquette, no key needed
GOOGLE_PLACES_API_KEY=                           # optional — nearby bait shops fall back to seed data without it

LLM_PROVIDER=mock                                # mock | openai | anthropic
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Demo/debug hook for the mock provider (see docs/adr/0007-ai-advisor-grounding.md).
# Lets you reproduce each advisor failure path on demand instead of waiting
# for a real model to misbehave:
#   none | unavailable | invalid_json | hallucinated_source | hallucinated_species
LLM_MOCK_FAILURE_MODE=none

USE_SEED_DATA_ONLY=true

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
