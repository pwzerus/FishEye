NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Vector basemap (preferred) --------------------------------------------
# A MapLibre style.json URL. When set, the maps are drawn from vector tiles in
# the browser instead of the raster tiles below, which is what lets single
# layers be hidden: the plane icons for every private airstrip in rural Texas
# are switched off in code (src/lib/map/basemapStyle.ts) while roads, towns,
# runways and airport areas stay. Needs WebGL; without it, or if this URL
# fails, the maps fall back to the raster settings below.
# NEXT_PUBLIC_MAP_STYLE_URL=https://api.maptiler.com/maps/streets-v4/style.json?key=YOUR_KEY_HERE

# --- Basemap tiles (raster fallback) ---------------------------------------
# Used when the vector basemap above is unset or unavailable.
# Leave both unset and the maps fall back to OpenStreetMap's own tile server.
# That is fine for local development and nothing else: the OSM Foundation's
# Tile Usage Policy treats those tiles as a service for OSM's own maps rather
# than as infrastructure other applications may build on, and a deployed app
# that leans on them can be throttled or blocked without notice. Anything
# public sets these two.
#
# Use a 256px tile URL. MapTiler counts a 512px tile as four API requests and
# a 256px tile as one, and 256 is what Leaflet assumes by default, so pointing
# these at a different provider stays a pure URL swap with no code change.
#
# MapTiler — key from https://cloud.maptiler.com/account/keys/, restricted
# there to this app's HTTP origins. Style ids that render as raster tiles
# (checked): streets-v4, outdoor-v4, topo-v4, landscape, dataviz, backdrop,
# toner-v2. Only landscape was seen with no airport icons at any zoom:
# streets-v4, topo-v4 and (zoomed in) outdoor-v4 mark every private airstrip
# in rural Texas. A style made in MapTiler's Customize tool is refused as
# raster tiles (403) on the free plan key tested.
# NEXT_PUBLIC_TILE_URL=https://api.maptiler.com/maps/landscape/256/{z}/{x}/{y}.png?key=YOUR_KEY_HERE
# NEXT_PUBLIC_TILE_ATTRIBUTION=<a href="https://www.maptiler.com/copyright/">&copy; MapTiler</a> <a href="https://www.openstreetmap.org/copyright">&copy; OpenStreetMap contributors</a>
#
# The real key belongs in .env.local, which is gitignored — never here.
# NEXT_PUBLIC_ values are inlined into the bundle at build time, so restart
# the dev server after changing them; a browser reload alone keeps the old map.
